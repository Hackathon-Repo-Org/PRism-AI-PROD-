# PRism-AI AI settings. Copy to .prism.env (git-ignored) or export as environment
# variables. `python prism.py setup` writes this file for you. Placeholders only.

# openai | anthropic — the API shape your provider speaks (default: openai)
PRISM_API_STYLE=openai
# Provider base URL; required for openai style (e.g. https://api.deepseek.com)
PRISM_BASE_URL=https://api.example.com/v1
# Provider API key; leave empty for a local Ollama
PRISM_API_KEY=replace-me
# Model name from your provider's docs
PRISM_MODEL=model-name

# Alternatives that work on their own (used only when PRISM_* are unset):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
